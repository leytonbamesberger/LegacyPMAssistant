# Copy to .env.local and fill in.
#
# VITE_* vars are inlined into the browser bundle — they are PUBLIC. Never put a
# secret in a VITE_* var.
#
# The vars WITHOUT the VITE_ prefix are server-only. Locally they're read by the
# /api dev middleware; on Vercel, set them in Project Settings → Environment
# Variables. SUPABASE_SERVICE_ROLE_KEY is a secret — treat it like a password.

# --- Supabase (client, public) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Azure AD / Microsoft Entra ID (MSAL, client, public) ---
# App registration (SPA) client ID
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Legacy Mechanical's tenant ID — restricts login to a single tenant.
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# Where MSAL returns after login (must match the app registration redirect URI).
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# --- Server only (NO VITE_ prefix — never sent to the browser) ---
# Supabase service-role key: Dashboard → Project Settings → API → service_role.
# Bypasses RLS. Used only by the /api handlers. SECRET — starts with "eyJ".
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional overrides — default to the VITE_ values above if omitted:
# SUPABASE_URL=https://your-project.supabase.co
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Base URL the browser app is served from. Used to build the Procore OAuth
# redirect/return URLs. Set to the deployed origin on Vercel.
APP_BASE_URL=http://localhost:5173

# --- Claude / Anthropic (server only, SECRET) ---
# https://console.anthropic.com/settings/keys — used server-side only, never VITE_.
ANTHROPIC_API_KEY=sk-ant-...

# --- Procore Developer (server only) ---
# Create an app at https://developers.procore.com → your app → OAuth Credentials.
# Add this exact redirect URI to the app's allowed list:
#   http://localhost:5173/api/procore/callback   (and your deployed URL + /api/procore/callback)
PROCORE_CLIENT_ID=your-procore-client-id
PROCORE_CLIENT_SECRET=your-procore-client-secret          # SECRET
# Defaults to APP_BASE_URL + /api/procore/callback if omitted:
# PROCORE_REDIRECT_URI=http://localhost:5173/api/procore/callback
# Random high-entropy string YOU generate (e.g. `openssl rand -hex 32`). Signs
# the short-lived OAuth "state" value. SECRET.
PROCORE_OAUTH_STATE_SECRET=generate-a-long-random-string
# Optional — point at the Procore developer sandbox instead of production:
# PROCORE_AUTH_BASE_URL=https://login-sandbox.procore.com
# PROCORE_API_BASE_URL=https://sandbox.procore.com
