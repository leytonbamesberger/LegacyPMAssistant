# Copy to .env.local and fill in. All client-exposed vars must be prefixed VITE_.

# --- Supabase ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Azure AD / Microsoft Entra ID (MSAL) ---
# App registration (SPA) client ID
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Legacy Mechanical's tenant ID — restricts login to a single tenant.
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# Where MSAL returns after login (must match the app registration redirect URI).
VITE_AZURE_REDIRECT_URI=http://localhost:5173
